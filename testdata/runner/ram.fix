# ram.fix: a 256-byte RAM on an 8-bit address bus and an 8-bit data bus.
# The data bus also feeds eight inverters, so the circuit sees what the
# memory drives: q_N is the inverse of data_N.
# device {"kind": "memory", "name": "ram", "addr": "addr", "data": "data", "select": "sel", "write": "we", "words": 256, "width": 8}
# input data_0 0,6
# output q_0 14,4
# input addr_0 20,0
# input data_1 0,18
# output q_1 14,16
# input addr_1 20,2
# input data_2 0,30
# output q_2 14,28
# input addr_2 20,4
# input data_3 0,42
# output q_3 14,40
# input addr_3 20,6
# input data_4 0,54
# output q_4 14,52
# input addr_4 20,8
# input data_5 0,66
# output q_5 14,64
# input addr_5 20,10
# input data_6 0,78
# output q_6 14,76
# input addr_6 20,12
# input data_7 0,90
# output q_7 14,88
# input addr_7 20,14
# input sel 20,18
# input we 20,20
# def inv 9x11
