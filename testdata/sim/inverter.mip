{
  "format": "mipsim",
  "version": 3,
  "note": "the plan's inverter, migrated from the 3x3 pattern language",
  "root": "top",
  "defs": {
    "top": {
      "origin": [
        0,
        0
      ],
      "rows": [
        "HHH",
        "HHH",
        "HHH",
        ".#",
        "#########",
        ".#",
        "#T",
        ".#",
        "LLL",
        "L.L",
        "LLL"
      ],
      "labels": [
        {
          "x": 0,
          "y": 6,
          "name": "in"
        },
        {
          "x": 8,
          "y": 4,
          "name": "out"
        }
      ]
    }
  },
  "tests": [
    {
      "set": {
        "in": "low"
      },
      "expect": {
        "out": "high"
      }
    },
    {
      "set": {
        "in": "high"
      },
      "expect": {
        "out": "low"
      }
    }
  ]
}
