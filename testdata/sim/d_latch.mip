{
  "format": "mipsim",
  "version": 3,
  "note": "pass transistor latch with complementary enables E and En",
  "root": "top",
  "defs": {
    "inv": {
      "w": 9,
      "h": 11,
      "rows": [
        "HHH",
        "HHH",
        "HHH",
        ".#",
        "#########",
        ".#",
        "#T",
        ".#",
        "LLL",
        "L.L",
        "LLL"
      ]
    },
    "top": {
      "origin": [
        0,
        4
      ],
      "rows": [
        ".....#.............#...........#",
        ".....#.#...........#...........#",
        "#####T####.........###.........#",
        ".......#.......................#",
        ".......T#......................#",
        ".......#.......................#",
        ".......#.......................#",
        ".......#.......................#",
        ".......#.......................#",
        ".......#########################"
      ],
      "labels": [
        {
          "x": 0,
          "y": 6,
          "name": "D"
        },
        {
          "x": 5,
          "y": 4,
          "name": "E"
        },
        {
          "x": 8,
          "y": 8,
          "name": "En"
        },
        {
          "x": 31,
          "y": 4,
          "name": "Q"
        },
        {
          "x": 19,
          "y": 4,
          "name": "Qn"
        }
      ],
      "instances": [
        {
          "id": "i1",
          "def": "inv",
          "x": 10,
          "y": 0,
          "name": "i2"
        },
        {
          "id": "i2",
          "def": "inv",
          "x": 22,
          "y": 0,
          "name": "i3"
        }
      ]
    }
  },
  "tests": [
    {
      "set": {
        "D": "high",
        "E": "high",
        "En": "low"
      },
      "expect": {
        "Q": "high",
        "Qn": "low"
      }
    },
    {
      "set": {
        "D": "low",
        "E": "high",
        "En": "low"
      },
      "expect": {
        "Q": "low",
        "Qn": "high"
      }
    },
    {
      "set": {
        "D": "low",
        "E": "low",
        "En": "high"
      },
      "expect": {
        "Q": "low"
      }
    },
    {
      "set": {
        "D": "high",
        "E": "low",
        "En": "high"
      },
      "expect": {
        "Q": "low"
      }
    },
    {
      "set": {
        "D": "high",
        "E": "high",
        "En": "low"
      },
      "expect": {
        "Q": "high"
      }
    },
    {
      "set": {
        "D": "high",
        "E": "low",
        "En": "high"
      },
      "expect": {
        "Q": "high"
      }
    },
    {
      "set": {
        "D": "low",
        "E": "low",
        "En": "high"
      },
      "expect": {
        "Q": "high"
      }
    }
  ]
}
