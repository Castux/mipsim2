{
  "format": "mipsim",
  "version": 3,
  "note": "NOR: two transistors in parallel, sharing power and ground; inputs on both sides",
  "root": "top",
  "defs": {
    "top": {
      "origin": [
        0,
        0
      ],
      "rows": [
        "..#",
        ".#H#",
        "#T.T#",
        ".LLL"
      ],
      "labels": [
        {
          "x": 0,
          "y": 2,
          "name": "a"
        },
        {
          "x": 4,
          "y": 2,
          "name": "b"
        },
        {
          "x": 2,
          "y": 0,
          "name": "out"
        }
      ]
    }
  },
  "tests": [
    {
      "set": {
        "a": "low",
        "b": "low"
      },
      "expect": {
        "out": "high"
      }
    },
    {
      "set": {
        "a": "high",
        "b": "low"
      },
      "expect": {
        "out": "low"
      }
    },
    {
      "set": {
        "a": "low",
        "b": "high"
      },
      "expect": {
        "out": "low"
      }
    },
    {
      "set": {
        "a": "high",
        "b": "high"
      },
      "expect": {
        "out": "low"
      }
    }
  ]
}
