{
  "format": "mipsim",
  "version": 3,
  "note": "XOR from four NAND instances: n = NAND(a,b), out = NAND(NAND(a,n), NAND(n,b))",
  "root": "top",
  "defs": {
    "nand": {
      "w": 3,
      "h": 5,
      "rows": [
        ".H#",
        "#T",
        ".#",
        "#T",
        ".L"
      ]
    },
    "top": {
      "origin": [
        0,
        0
      ],
      "rows": [
        "............##",
        ".########....#",
        ".#...........#",
        ".#.....##....#",
        ".#....##.....#....##",
        "###....#.....##",
        ".......#",
        "###....#.....##",
        ".#.....#....##",
        ".#.....##",
        ".#",
        ".#......#",
        ".#......#",
        ".########"
      ],
      "labels": [
        {
          "x": 0,
          "y": 5,
          "name": "a"
        },
        {
          "x": 0,
          "y": 7,
          "name": "b"
        },
        {
          "x": 19,
          "y": 4,
          "name": "out"
        }
      ],
      "instances": [
        {
          "id": "i1",
          "def": "nand",
          "x": 3,
          "y": 4,
          "name": "g1"
        },
        {
          "id": "i2",
          "def": "nand",
          "x": 9,
          "y": 0,
          "name": "g2"
        },
        {
          "id": "i3",
          "def": "nand",
          "x": 9,
          "y": 8,
          "name": "g3"
        },
        {
          "id": "i4",
          "def": "nand",
          "x": 15,
          "y": 4,
          "name": "g4"
        }
      ]
    }
  },
  "tests": [
    {
      "set": {
        "a": "low",
        "b": "low"
      },
      "expect": {
        "out": "low"
      }
    },
    {
      "set": {
        "a": "high",
        "b": "low"
      },
      "expect": {
        "out": "high"
      }
    },
    {
      "set": {
        "a": "low",
        "b": "high"
      },
      "expect": {
        "out": "high"
      }
    },
    {
      "set": {
        "a": "high",
        "b": "high"
      },
      "expect": {
        "out": "low"
      }
    }
  ]
}
