{
  "format": "mipsim",
  "version": 2,
  "note": "cross-coupled NOR gates, the second rotated 180 degrees",
  "root": "top",
  "defs": {
    "nor": {
      "w": 9,
      "h": 13,
      "rows": [
        "###",
        "###",
        "###",
        ".#...#",
        "#########",
        ".#...#",
        "##...####",
        ".#.#.#",
        ".#####",
        "...#",
        "..###",
        "..#.#",
        "..###"
      ]
    },
    "top": {
      "origin": [
        -16,
        4
      ],
      "rows": [
        ".........................####",
        "............................#",
        "...............#.........##.##.........#",
        "..........................#",
        "..........................####"
      ],
      "labels": [
        {
          "x": -1,
          "y": 6,
          "name": "R"
        },
        {
          "x": 23,
          "y": 6,
          "name": "S"
        },
        {
          "x": 9,
          "y": 4,
          "name": "Q"
        },
        {
          "x": 9,
          "y": 6,
          "name": "Qn"
        }
      ],
      "instances": [
        {
          "id": "i1",
          "def": "nor",
          "x": 0,
          "y": 0,
          "name": "n1"
        },
        {
          "id": "i2",
          "def": "nor",
          "x": 14,
          "y": 0,
          "orient": "r180",
          "name": "n2"
        }
      ]
    }
  },
  "tests": [
    {
      "set": {
        "R": "low",
        "S": "high"
      },
      "expect": {
        "Q": "high",
        "Qn": "low"
      }
    },
    {
      "set": {
        "R": "low",
        "S": "low"
      },
      "expect": {
        "Q": "high",
        "Qn": "low"
      }
    },
    {
      "set": {
        "R": "high",
        "S": "low"
      },
      "expect": {
        "Q": "low",
        "Qn": "high"
      }
    },
    {
      "set": {
        "R": "low",
        "S": "low"
      },
      "expect": {
        "Q": "low",
        "Qn": "high"
      }
    },
    {
      "set": {
        "R": "high",
        "S": "high"
      },
      "expect": {
        "Q": "low",
        "Qn": "low"
      }
    }
  ]
}
