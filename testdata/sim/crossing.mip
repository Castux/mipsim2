{
  "format": "mipsim",
  "version": 3,
  "note": "two signals cross through a bridge into two inverters",
  "root": "top",
  "defs": {
    "inv": {
      "w": 9,
      "h": 11,
      "rows": [
        "HHH",
        "HHH",
        "HHH",
        ".#",
        "#########",
        ".#",
        "#T",
        ".#",
        "LLL",
        "L.L",
        "LLL"
      ]
    },
    "top": {
      "origin": [
        0,
        0
      ],
      "rows": [
        ".....#",
        ".....#",
        ".....#",
        ".....#",
        ".....#.............#",
        ".....#",
        "#####B####",
        ".....#",
        ".....#",
        ".....#",
        ".....#",
        ".....#",
        ".....#",
        ".....#",
        ".....#",
        ".....#",
        ".....#..........#",
        ".....#",
        ".....##"
      ],
      "labels": [
        {
          "x": 0,
          "y": 6,
          "name": "a"
        },
        {
          "x": 5,
          "y": 0,
          "name": "b"
        },
        {
          "x": 19,
          "y": 4,
          "name": "na"
        },
        {
          "x": 16,
          "y": 16,
          "name": "nb"
        }
      ],
      "instances": [
        {
          "id": "i1",
          "def": "inv",
          "x": 10,
          "y": 0,
          "name": "ia"
        },
        {
          "id": "i2",
          "def": "inv",
          "x": 7,
          "y": 12,
          "name": "ib"
        }
      ]
    }
  },
  "tests": [
    {
      "set": {
        "a": "low",
        "b": "high"
      },
      "expect": {
        "na": "high",
        "nb": "low"
      }
    },
    {
      "set": {
        "a": "high",
        "b": "low"
      },
      "expect": {
        "na": "low",
        "nb": "high"
      }
    },
    {
      "set": {
        "a": "high",
        "b": "high"
      },
      "expect": {
        "na": "low",
        "nb": "low"
      }
    }
  ]
}
