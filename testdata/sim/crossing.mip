{
  "format": "mipsim",
  "version": 3,
  "note": "two signals cross at a bridge on their way to two inverters",
  "root": "top",
  "defs": {
    "inv": {
      "w": 3,
      "h": 3,
      "rows": [
        ".H#",
        "#T",
        ".L"
      ]
    },
    "top": {
      "origin": [
        0,
        -2
      ],
      "rows": [
        "....#",
        "....#",
        "....#......#",
        "####B###",
        "....#",
        "....#",
        "....#",
        "....#...#",
        "....#"
      ],
      "labels": [
        {
          "x": 0,
          "y": 1,
          "name": "a"
        },
        {
          "x": 4,
          "y": -2,
          "name": "b"
        },
        {
          "x": 11,
          "y": 0,
          "name": "na"
        },
        {
          "x": 8,
          "y": 5,
          "name": "nb"
        }
      ],
      "instances": [
        {
          "id": "i1",
          "def": "inv",
          "x": 8,
          "y": 0,
          "name": "ia"
        },
        {
          "id": "i2",
          "def": "inv",
          "x": 5,
          "y": 5,
          "name": "ib"
        }
      ]
    }
  },
  "tests": [
    {
      "set": {
        "a": "low",
        "b": "high"
      },
      "expect": {
        "na": "high",
        "nb": "low"
      }
    },
    {
      "set": {
        "a": "high",
        "b": "low"
      },
      "expect": {
        "na": "low",
        "nb": "high"
      }
    },
    {
      "set": {
        "a": "high",
        "b": "high"
      },
      "expect": {
        "na": "low",
        "nb": "low"
      }
    }
  ]
}
