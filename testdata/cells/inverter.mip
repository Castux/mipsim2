{
  "format": "mipsim",
  "version": 3,
  "note": "inverter: power, transistor and ground in a column; the output leaves the power cell",
  "root": "top",
  "defs": {
    "top": {
      "origin": [
        0,
        0
      ],
      "rows": [
        ".H#",
        "#T",
        ".L"
      ],
      "labels": [
        {
          "x": 0,
          "y": 1,
          "name": "in"
        },
        {
          "x": 2,
          "y": 0,
          "name": "out"
        }
      ]
    }
  },
  "tests": [
    {
      "set": {
        "in": "low"
      },
      "expect": {
        "out": "high"
      }
    },
    {
      "set": {
        "in": "high"
      },
      "expect": {
        "out": "low"
      }
    }
  ]
}
