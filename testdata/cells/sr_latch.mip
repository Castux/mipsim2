{
  "format": "mipsim",
  "version": 3,
  "note": "SR latch: cross-coupled NORs, as sr_latch",
  "root": "top",
  "defs": {
    "top": {
      "origin": [
        0,
        -2
      ],
      "rows": [
        ".....######",
        ".....#....#",
        "..###B##..#",
        "..#..#.#..#",
        ".#H#.#.#.#H#",
        "#T.T##.##T.T#",
        ".LLL.....LLL"
      ],
      "labels": [
        {
          "x": 0,
          "y": 3,
          "name": "r"
        },
        {
          "x": 12,
          "y": 3,
          "name": "s"
        },
        {
          "x": 3,
          "y": 0,
          "name": "q"
        },
        {
          "x": 10,
          "y": 0,
          "name": "qn"
        }
      ]
    }
  },
  "tests": [
    {
      "set": {
        "s": "high",
        "r": "low"
      },
      "expect": {
        "q": "high",
        "qn": "low"
      }
    },
    {
      "set": {
        "s": "low",
        "r": "low"
      },
      "expect": {
        "q": "high",
        "qn": "low"
      }
    },
    {
      "set": {
        "s": "low",
        "r": "high"
      },
      "expect": {
        "q": "low",
        "qn": "high"
      }
    },
    {
      "set": {
        "s": "low",
        "r": "low"
      },
      "expect": {
        "q": "low",
        "qn": "high"
      }
    },
    {
      "set": {
        "s": "high",
        "r": "high"
      },
      "expect": {
        "q": "low",
        "qn": "low"
      }
    }
  ]
}
