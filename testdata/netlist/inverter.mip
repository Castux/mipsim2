{
  "format": "mipsim",
  "version": 2,
  "root": "top",
  "defs": {
    "top": {
      "origin": [
        0,
        0
      ],
      "rows": [
        "###",
        "###",
        "###",
        ".#",
        "#########",
        ".#",
        "##",
        ".#",
        "###",
        "#.#",
        "###"
      ],
      "labels": [
        {
          "x": 0,
          "y": 6,
          "name": "in"
        },
        {
          "x": 8,
          "y": 4,
          "name": "out"
        }
      ]
    }
  },
  "tests": [
    {
      "set": {
        "in": "low"
      },
      "expect": {
        "out": "high"
      }
    },
    {
      "set": {
        "in": "high"
      },
      "expect": {
        "out": "low"
      }
    }
  ],
  "checks": {
    "diag": [],
    "nets": 3,
    "transistors": 1
  }
}
